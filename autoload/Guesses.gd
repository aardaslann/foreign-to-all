const ALL := {
	"german": GERMAN,
	"swissgerman": SWISSGERMAN,
	"english": ENGLISH,
	"french": FRENCH,
	"italian": ITALIAN,
	"russian": RUSSIAN,
	"turkish": TURKISH,
}


static func has_language(language: String) -> bool:
	return ALL.has(language)


# German is two tables: this one, and the words Kerstin's Berlin adds
# (GuessesBerlin.gd). Merged once, with this one winning where both have a word.
const BERLIN := preload("res://autoload/GuessesBerlin.gd")
static var _german: Dictionary = {}


static func table(language: String) -> Dictionary:
	if language == "german":
		if _german.is_empty():
			_german = BERLIN.WORDS.duplicate()
			_german.merge(GERMAN, true)
		return _german
	return ALL.get(language, {})
