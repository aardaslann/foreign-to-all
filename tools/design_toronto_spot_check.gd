extends "res://tools/design_mexico_spot_check.gd"

# Representative final-art integrations only, not exhaustive walking QA.
func _run() -> void:
	await load_world("TorontoDowntown")
	await create_timer(.4).timeout
	still()
	if OS.get_cmdline_user_args().has("--downtown-only"):
		# Centre of the real pavement gap between lamp and bin, including
		# the player's half-width; the previous x1355 grazed the bin edge.
		await walk_route("downtown-shelter-rear",[feet(1349,780),feet(1349,655),feet(1154,655)])
		await capture("downtown-glass",feet(1154,655))
		await capture("downtown-shelter-front",feet(1154,743))
		print("TORONTO_DOWNTOWN_RECHECK ",failures.size()," failures")
		quit(0 if failures.is_empty() else 1)
		return
	await walk_route("downtown-hotel",[feet(287,799),feet(287,675)])
	await walk_route("downtown-exchange",[feet(691,799),feet(691,675)])
	await walk_route("downtown-shelter-rear",[feet(1349,780),feet(1349,655),feet(1154,655)])
	await capture("downtown-glass",feet(1154,655))
	await capture("downtown-shelter-front",feet(1154,743))
	await sweep("downtown shelter base contact",feet(1154,743),feet(1154,655),true)
	await load_world("TorontoGerrard")
	still()
	await walk_route("gerrard-shelter-rear",[feet(1010,800),feet(1010,658),feet(1250,658)])
