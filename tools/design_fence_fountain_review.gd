extends "res://tools/design_boundary_routes.gd"

# Independent positions measured against the artwork and user screenshots.
# Exercises negative space as well as objects that must stop walking.
func _run() -> void:
	await load_world("Mitte")
	await create_timer(.4).timeout
	player.position=Vector2(483,420)
	check(await walk_to(Vector2(599,420)),"walk behind U-Bahn railing from the left pavement")
	await capture("mitte-behind-railing",player.position)
	await sweep("U-Bahn stairwell stays solid",Vector2(599,508),Vector2(599,450),true)
	await capture("mitte-bike-handle",Vector2(496,427))
	await load_world("BerlinPrenzlberg")
	await sweep("park left fence blocks crossing",Vector2(775,521),Vector2(775,442),true)
	await capture("park-front",Vector2(775,509))
	await sweep("park right fence blocks crossing",Vector2(1035,522),Vector2(1035,449),true)
	player.position=Vector2(880,521)
	check(await walk_to(Vector2(880,440)),"park gate leaves a usable passage")
	await capture("park-open-gate",player.position)
	await load_world("IstanbulHan")
	await sweep("fountain west rim blocks feet",Vector2(407,535),Vector2(574,535),true)
	await sweep("fountain east rim blocks feet",Vector2(747,537),Vector2(574,537),true)
	await sweep("fountain front step blocks feet",Vector2(574,610),Vector2(574,530),true)
	await sweep("fountain rear basin blocks feet",Vector2(574,466),Vector2(574,541),true)
	await capture("han-fountain-west",Vector2(410,539))
	await capture("han-fountain-front",Vector2(574,610))
	await capture("han-fountain-behind",Vector2(574,466))
	await sweep("tree planter blocks walking through soil",Vector2(102,583),Vector2(102,471),true)
	player.set_process(false)
	player.get_node("Sprite").pause()
	var tree := scene.get_node("Object_tree_planter")
	var visible_tree := await capture("han-tree-behind",Vector2(104,471))
	tree.hide()
	var hidden_tree := await capture("han-tree-probe",Vector2(104,471))
	check(changed_pixels(visible_tree,hidden_tree,Rect2(94,394,22,65))>50,"tree trunk hides the actor above the planter")
	tree.show()
	await capture("han-tree-front",Vector2(104,567))
	await load_world("IstanbulHastane")
	await capture("hospital-plant-behind",Vector2(564,540))
	await capture("hospital-plant-front",Vector2(564,605))
	await load_world("Restaurant")
	await capture("restaurant-right-booth",Vector2(405,480))
	await load_world("IstanbulYusuf")
	await capture("yusuf-crates-behind",Vector2(196,517))
	await capture("yusuf-plant-behind",Vector2(1095,427))
	await load_world("IstanbulLokanta")
	await capture("lokanta-middle-chair",Vector2(658,451))
	await capture("lokanta-east-chair",Vector2(1087,451))
	await capture("lokanta-middle-table",Vector2(580,414))
	await load_world("HotelRoom")
	await sweep("wardrobe projects into room and blocks feet",Vector2(93,405),Vector2(93,348),true)
	check(not clear_at(Vector2(1040,350)),"desk footprint excludes standing underneath its top")
	await capture("room-desk-edge",Vector2(922,384))
	await load_world("IstanbulBeyoglu")
	await capture("beyoglu-plant-edge",Vector2(926,444))
	print("FENCE_FOUNTAIN_REVIEW ",failures.size()," failures")
	quit(0 if failures.is_empty() else 1)
