<mxCell id="v112" value="&lt;b&gt;After the naming&lt;/b&gt;&lt;br&gt;Keep exploring • credits&lt;br&gt;Optional local feedback" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#23352F;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=12;fillColor=#DCEDE2;strokeColor=#23352F;strokeWidth=1.5;rounded=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030" y="850" width="285" height="115" as="geometry"/></mxCell>
<mxCell id="e113" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#23352F;strokeWidth=2;fontFamily=Helvetica;fontSize=15;fontColor=#23352F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v110" target="v112"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="v114" value="&lt;b&gt;Time supports the journey&lt;/b&gt;&lt;br&gt;24-hour local clock; 40 active minutes per day.&lt;br&gt;Reading, menus and films pause time.&lt;br&gt;Beds: morning 08:00 / evening 18:00.&lt;br&gt;Travel advances time; no missed appointments." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#23352F;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=12;fillColor=#F0F3F1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1370" y="225" width="330" height="250" as="geometry"/></mxCell>
<mxCell id="v115" value="&lt;b&gt;Support without a chore tax&lt;/b&gt;&lt;br&gt;Essential money and travel have safety nets.&lt;br&gt;Map and current intention help orientation.&lt;br&gt;Mistakes do not end the game.&lt;br&gt;No fluency exam or full-activity checklist." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#23352F;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=12;fillColor=#F0F3F1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1370" y="515" width="330" height="220" as="geometry"/></mxCell>
<mxCell id="v116" value="&lt;b&gt;Eight core cities only&lt;/b&gt;&lt;br&gt;Berlin, Istanbul, London, Paris,&lt;br&gt;Moscow, Mumbai, Tokyo,&lt;br&gt;Mexico City.&lt;br&gt;&lt;br&gt;After Berlin: no fixed route." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#23352F;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=12;fillColor=#F0F3F1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1370" y="785" width="330" height="210" as="geometry"/></mxCell>
<mxCell id="v117" value="Current implemented beta flow. Optional use encounters enrich learning but do not block story progress. No measured completion-time claim." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#23352F;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=12;fontSize=17;fontColor=#56645E;" vertex="1" parent="1"><mxGeometry x="50" y="1043" width="1650" height="48" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
