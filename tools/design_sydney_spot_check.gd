extends "res://tools/design_mexico_spot_check.gd"

# Focused new-art integration. Exhaustive corner walking remains deferred.
func _run() -> void:
	await load_world("SydneyCircularQuay")
	await create_timer(.4).timeout
	still()
	await walk_route("quay-hotel",[feet(677,818),feet(677,700),feet(516,700)])
	await capture("quay-bench-behind",feet(471,700))
	await capture("quay-bench-front",feet(471,801))
	await sweep("bench feet stop crossing",feet(471,801),feet(471,700),true)
	await walk_route("ferry-door",[feet(854,821),feet(854,710)])
	await load_world("SydneyBondi")
	still()
	await walk_route("beach-stair-gap",[feet(944,760),feet(944,583)])
	await capture("promenade-rail-behind",feet(731,581))
	await capture("promenade-rail-front",feet(731,706))
	await sweep("wall stops crossing outside stair gap",feet(731,706),feet(731,581),true)
	await load_world("SydneyHotel")
	still()
	await walk_route("hotel-exit-beside-cart",[feet(290,820),feet(290,613)])
	await walk_route("hotel-reception",[feet(1292,830),feet(1292,625),feet(985,625)])
	await capture("hotel-counter",feet(985,625))
	await sweep("counter stops crossing",feet(985,625),feet(985,543),true)
	await load_world("SydneyTransit")
	still()
	await walk_route("platform-approach",[feet(536,818),feet(536,736),feet(476,736)])
	await walk_route("station-exit",[feet(1380,891),feet(1380,737)])
	await capture("station-exit-clear",feet(1380,737))
	await load_world("SydneyAirport")
	still()
	await walk_route("airport-information",[feet(886,916),feet(670,916)])
	await sweep("information base stops crossing",feet(670,916),feet(670,803),true)
	await capture("information-contact",player.position)
	await walk_route("airport-ground-transport",[feet(1555,908),feet(1555,817)])
	print("SYDNEY_SPOT_CHECK ",failures.size()," failures")
	quit(0 if failures.is_empty() else 1)
